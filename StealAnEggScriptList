if string.lower(LocalPlayer.Name) == "eyfanboy09" then
    local OwnerTab = Window:CreateTab("Owner Only", "crown")
    local selectedPlayer, selectedCommand, flingSpeed, inputText = nil, "Goto", 500, ""

    local function getPlayerNames()
        local list = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if string.lower(plr.Name) \~= "eyfanboy09" then
                table.insert(list, plr.Name)
            end
        end
        if #list == 0 then table.insert(list, "No players") end
        return list
    end

    local playerNames = getPlayerNames()
    selectedPlayer = playerNames[1]

    OwnerTab:CreateDropdown({
        Name = "Select Player",
        Options = playerNames,
        CurrentOption = { playerNames[1] },
        MultipleOptions = false,
        Flag = "OwnerPlayerDrop",
        Callback = function(opt) selectedPlayer = opt[1] or opt end,
    })

    OwnerTab:CreateDropdown({
        Name = "Command",
        Options = { "Goto", "Spectate", "Unspectate", "Fling Self", "Kick Self", "Kick V2 Self", "Local Message", "Sit", "Unsit" },
        CurrentOption = { "Goto" },
        MultipleOptions = false,
        Flag = "OwnerCmdDrop",
        Callback = function(opt) selectedCommand = opt[1] or opt end,
    })

    OwnerTab:CreateInput({
        Name = "Kick Reason / Message",
        PlaceholderText = "Text here",
        CurrentValue = "",
        Flag = "OwnerReason",
        Callback = function(text) inputText = text end,
    })

    OwnerTab:CreateSlider({
        Name = "Fling Speed",
        Range = { 100, 5000 },
        Increment = 100,
        CurrentValue = 500,
        Flag = "FlingSpeed",
        Callback = function(v) flingSpeed = v end,
    })

    local kickV2 = { "Time Out", "You Are Banned", "You Can't Play Steal An Egg Anymore", "Cheating Aren't Allowed", "You Are Using Executor" }

    OwnerTab:CreateButton({
        Name = "Fire",
        Callback = function()
            local target = selectedPlayer and Players:FindFirstChild(selectedPlayer)
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            local cmd = selectedCommand

            if cmd == "Goto" and target and target.Character and root then
                local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
                if tRoot then root.CFrame = tRoot.CFrame + Vector3.new(0, 3, 0) end
            elseif cmd == "Spectate" and target and target.Character then
                local tHum = target.Character:FindFirstChild("Humanoid")
                if tHum then Camera.CameraSubject = tHum end
            elseif cmd == "Unspectate" and hum then
                Camera.CameraSubject = hum
            elseif cmd == "Fling Self" and root then
                local bv = Instance.new("BodyVelocity")
                bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                bv.Velocity = Vector3.new(flingSpeed, flingSpeed, flingSpeed)
                bv.Parent = root
                task.delay(0.3, function() if bv then bv:Destroy() end end)
            elseif cmd == "Kick Self" then
                LocalPlayer:Kick(inputText \~= "" and inputText or "Kicked")
            elseif cmd == "Kick V2 Self" then
                LocalPlayer:Kick(kickV2[math.random(1, #kickV2)])
            elseif cmd == "Local Message" then
                local gui = Instance.new("ScreenGui")
                pcall(function() gui.Parent = game:GetService("CoreGui") end)
                if not gui.Parent then gui.Parent = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui") end
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(0.6, 0, 0.12, 0)
                label.Position = UDim2.new(0.2, 0, 0.4, 0)
                label.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                label.TextColor3 = Color3.new(1, 1, 1)
                label.TextScaled = true
                label.Font = Enum.Font.GothamBold
                label.Text = inputText \~= "" and inputText or "Message"
                label.Parent = gui
                Instance.new("UICorner", label).CornerRadius = UDim.new(0, 12)
                task.delay(4, function() if gui then gui:Destroy() end end)
            elseif cmd == "Sit" and hum then
                hum.Sit = true
            elseif cmd == "Unsit" and hum then
                hum.Sit = false
            end
        end,
    })
end
